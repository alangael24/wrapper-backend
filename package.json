{
  "name": "wrapper-backend-pi-runtime",
  "private": true,
  "version": "1.1.3",
  "description": "Agent Genia desktop client and Pi harness runtime",
  "author": "Agent Genia",
  "license": "UNLICENSED",
  "homepage": "https://agentgenia.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/alangael24/wrapper-backend.git"
  },
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22"
  },
  "main": "desktop/dist/main.mjs",
  "scripts": {
    "build:desktop": "node desktop/build.mjs",
    "desktop": "pnpm build:desktop && electron .",
    "pack:desktop": "pnpm build:desktop && electron-builder --dir --publish never",
    "dist:desktop": "pnpm build:desktop && electron-builder --publish never",
    "dist:mac": "pnpm build:desktop && electron-builder --mac --publish never",
    "dist:win": "pnpm build:desktop && electron-builder --win --publish never",
    "dist:linux": "pnpm build:desktop && electron-builder --linux --publish never",
    "release:desktop": "pnpm build:desktop && electron-builder --publish always",
    "release:verify": "node scripts/verify-release-config.mjs",
    "smoke:desktop": "pnpm build:desktop && electron . --smoke-test",
    "test:connectors": "pnpm typecheck:connectors && node --test tests/test_connector_extension.mjs",
    "test:interactions": "scripts/test-connector-interactions",
    "typecheck:connectors": "tsc -p extensions/connectors/tsconfig.json && tsc -p extensions/runtime-auth/tsconfig.json",
    "typecheck:desktop": "tsc -p desktop/tsconfig.json --noEmit",
    "test:desktop": "pnpm typecheck:desktop && pnpm build:desktop && node --test tests/test_desktop.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@injaneity/pi-computer-use": "0.5.0",
    "electron-updater": "6.8.9",
    "pi-chrome": "0.15.46",
    "simple-icons": "^15.15.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
