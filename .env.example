# Copia este archivo a .env (o exporta las variables) y ajusta los valores.

# Puerto HTTP del backend
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8787

# Clave maestra para credenciales de conectores y sesiones. En producción debe
# ser un secreto estable; no dependas de data/secret.key en un disco efímero.
WRAPPER_SECRET=
# Rotación: sube la versión al cambiar WRAPPER_SECRET y conserva temporalmente
# las anteriores como JSON, por ejemplo {"1":"secreto-anterior-largo"}.
WRAPPER_SECRET_VERSION=1
WRAPPER_SECRET_PREVIOUS_JSON={}

# Token de admin para los endpoints /admin/*. En produccion define un valor
# aleatorio largo (por ejemplo, generado con `openssl rand -hex 32`). En
# producción es obligatorio. En desarrollo puede ser efímero y nunca se imprime.
ADMIN_TOKEN=

# Produccion stateless: usa el connection string de Supabase y guárdalo
# exclusivamente como secreto del host. El backend fuerza TLS fuera de loopback.
DATABASE_URL=
# Desarrollo local/fallback: SQLite se usa solo cuando DATABASE_URL está vacío.
DB_PATH=data/wrapper.sqlite

# Cuenta DeepSeek propiedad de Agent Genia. La key solo existe en el servidor;
# las aplicaciones y los usuarios nunca la reciben ni pueden reemplazarla.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Wallet de créditos. Empieza en shadow para medir sin bloquear y cambia a
# enforce cuando los datos de producción estén validados.
CREDITS_MODE=shadow
CREDIT_LLM_MULTIPLIER_BPS=12500
CREDIT_DISPLAY_INCREMENT_MILLI=100
TRIAL_CREDITS=30
TRIAL_CREDITS_TTL_DAYS=30
DEFAULT_RUN_MAX_CREDITS=25
DEEP_RUN_MAX_CREDITS=50
CREDIT_RESERVATION_TTL_SECONDS=3900

# Login principal de Agent Genia con Google. Crea un cliente OAuth 2.0 tipo
# "Web application" y registra exactamente esta ruta como redirect URI.
# En producción la URL debe ser HTTPS; HTTP solo se admite en loopback local.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.tu-dominio.com/v1/account-auth/google/callback
# Sign in with Apple nativo. La llave .p8 debe guardarse como base64 de su PEM;
# se usa para intercambiar/revocar el token y nunca se incluye en la app.
APPLE_CLIENT_ID=com.agentgenia.ios
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_BASE64=
# Tokens opacos propios del wrapper: 15 minutos / 30 días por defecto.
ACCOUNT_ACCESS_TTL_SECONDS=900
ACCOUNT_REFRESH_TTL_SECONDS=2592000
ACCOUNT_AUTH_ATTEMPT_TTL_SECONDS=600
# El signup antiguo por API se mantiene solo para desarrollo. En producción el
# login verificado de Google/Apple es la única ruta de alta.
PUBLIC_LEGACY_SIGNUP_ENABLED=1

# Suscripciones reales de Agentgenia mediante Stripe Checkout. Activa esto solo
# en el backend público después de guardar la secret key y el webhook secret en
# el entorno privado del host. Nunca copies estos secretos dentro de Electron.
STRIPE_ENABLED=0
STRIPE_LIVE_MODE=1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs live: Starter $29, Pro $79 y Business $199. El alias histórico
# STRIPE_PLUS_PRICE_ID sigue aceptado temporalmente, pero usa STARTER en nuevos despliegues.
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
# Páginas web HTTPS a las que Stripe devuelve al usuario.
STRIPE_SUCCESS_URL=https://tu-dominio.com/billing/success
STRIPE_CANCEL_URL=https://tu-dominio.com/pricing
STRIPE_PORTAL_RETURN_URL=https://tu-dominio.com/account
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Harness de Pi. Viene apagado porque Pi puede ejecutar shell y escribir archivos.
# El launcher Bubblewrap vive fuera de go_backend/pi_harness.py y falla cerrado.
# Requisitos y threat model: docs/pi-sandbox.md
PI_ENABLED=0
PI_BIN=./scripts/pi-sandbox
# Solo hace falta si `node` no esta en PATH.
PI_NODE_BIN_DIR=
PI_BACKEND_URL=http://127.0.0.1:8787
PI_RUNS_DIR=data/pi-runs
PI_MODEL=deepseek-v4-flash
PI_THINKING=high
# 0 = sin timeout
PI_TIMEOUT_SECONDS=1800
PI_MAX_CONCURRENT=4
PI_MAX_PROMPT_CHARS=100000

# Extension first-party de conectores para Pi. Solo recibe la URL loopback y un
# token efimero por ejecucion; nunca recibe client secrets ni refresh tokens.
PI_CONNECTOR_EXTENSION=./extensions/connectors/index.ts
# El default es PI_TIMEOUT_SECONDS + 60, con maximo absoluto de 3600 segundos.
PI_CONNECTOR_TOKEN_TTL_SECONDS=1860

# pi-chrome se instala con pnpm. El backend copia y configura su extension
# companion dentro de un perfil Chrome efimero distinto para cada ejecucion.
PI_CHROME_EXTENSION=./node_modules/pi-chrome/extensions/chrome-profile-bridge/index.ts
# Vacio = autodetectar Chrome for Testing/Chromium. Chrome estable no admite
# cargar esta extension por CLI desde v137. Nunca apuntar a un perfil de usuario.
PI_CHROME_BIN=
# Es el unico modo admitido; el servidor rechaza shared u otros valores.
PI_CHROME_ISOLATION=per_run
# Al activarlo solo autoriza el perfil efimero de esa ejecucion.
PI_CHROME_AUTO_AUTHORIZE=0
PI_CHROME_AUTHORIZE_MINUTES=30

# Unico backend usado por Electron para login, billing, conectores y agentes.
# Debe ser HTTPS fuera de loopback. Nunca empaquetes secretos en Electron.
WRAPPER_SERVICE_URL=https://agentgenia-api.onrender.com

# Conectores reales administrados dentro de wrapper-backend. Composio guarda y
# renueva los tokens por user_id; Pi y Electron nunca reciben esos tokens.
COMPOSIO_API_KEY=
COMPOSIO_PUBLIC_URL=https://agentgenia-api.onrender.com
# URL publica usada tambien por los formularios first-party de un solo uso.
# Si se omite, hereda COMPOSIO_PUBLIC_URL.
CONNECTOR_PUBLIC_URL=https://agentgenia-api.onrender.com
# JSON connector/toolkit -> Auth Config propio. En producción es obligatorio y
# debe cubrir todo proveedor sin Managed Auth, por ejemplo Salesforce o
# Snowflake; `/readyz` falla si cualquier conector publicado queda inutilizable.
COMPOSIO_AUTH_CONFIGS_JSON={}
# JSON opcional connector_id -> toolkit_slug para cambios del catalogo.
COMPOSIO_TOOLKIT_OVERRIDES_JSON={}
COMPOSIO_AUTH_ATTEMPT_TTL_SECONDS=600

# Una computadora privada y persistente por bot. Daytona cobra compute solo
# mientras la sandbox está activa; auto-stop conserva el filesystem y
# auto-archive mueve sandboxes inactivas a almacenamiento más económico.
# El API key vive exclusivamente en el backend. Nunca lo empaquetes en Electron.
COMPUTERS_ENABLED=0
DAYTONA_API_KEY=
# Opcionales: el SDK usa https://app.daytona.io/api y la región predeterminada.
DAYTONA_API_URL=
DAYTONA_TARGET=
# Snapshot preparado con las aplicaciones que quieres entregar. Vacío usa el
# snapshot Python predeterminado; Computer Use levanta XFCE/noVNC al encender.
DAYTONA_SNAPSHOT=
COMPUTER_AUTO_STOP_MINUTES=15
# Tras 24 h detenida, archiva el filesystem. 0 usa el máximo del proveedor.
COMPUTER_AUTO_ARCHIVE_MINUTES=1440
# Viewer firmado: mínimo 60 s, máximo 24 h. El cliente solicita uno nuevo al abrir.
COMPUTER_PREVIEW_TTL_SECONDS=3600
COMPUTER_VNC_PORT=6080
COMPUTER_VNC_RESOLUTION=1440x900
# Protección de costo: cada bot con computadora cuenta aunque esté archivado.
COMPUTER_BASIC_LIMIT=1
COMPUTER_PRO_LIMIT=3
