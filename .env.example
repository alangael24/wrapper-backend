# Copia este archivo a .env (o exporta las variables) y ajusta los valores.

# Puerto HTTP del backend
PORT=8787

# Clave maestra para cifrar las keys de Go (si no existe, se genera
# automaticamente y se guarda en data/secret.key)
WRAPPER_SECRET=

# Token de admin para los endpoints /admin/*. En produccion define un valor
# aleatorio largo (por ejemplo, generado con `openssl rand -hex 32`). Si se deja
# vacio, el servidor genera uno temporal y lo imprime al arrancar.
ADMIN_TOKEN=

# Base de datos SQLite
DB_PATH=data/wrapper.sqlite

# Upstream de OpenCode Go (no tocar salvo que cambie)
GO_BASE_URL=https://opencode.ai/zen/go/v1

# 1 = rechaza requests cuando el usuario alcanza los limites de Go
# ajustados a su tier (free=$0, basic=50%, pro=100% de 5h/$12, semana/$30,
# mes/$60). 0 = solo registra uso.
ENFORCE_LIMITS=1

# Puente multimodal para modelos DeepSeek de solo texto. Cuando una request
# contiene imagenes, Luna genera evidencia visual y DeepSeek resuelve la tarea.
VISION_ENABLED=1
VISION_MODEL=gpt-5.6-luna
# Si Luna falla, se intenta este modelo. Deja vacio para no usar fallback.
VISION_FALLBACK_MODEL=mimo-v2.5
# Prefijos de modelos de texto que necesitan el puente (separados por coma).
VISION_TARGET_MODELS=deepseek-v4
VISION_MAX_OUTPUT_TOKENS=2048
VISION_FALLBACK_MAX_OUTPUT_TOKENS=4096
VISION_REASONING_EFFORT=minimal
VISION_REPORT_LIMIT=8000
VISION_CACHE_ENTRIES=128
VISION_MAX_GROUPS=6
VISION_MAX_IMAGES=12

# Harness de Pi. Viene apagado porque Pi puede ejecutar shell y escribir archivos.
PI_ENABLED=0
PI_BIN=./node_modules/.bin/pi
# Solo hace falta si `node` no esta en PATH.
PI_NODE_BIN_DIR=
PI_BACKEND_URL=http://127.0.0.1:8787
PI_RUNS_DIR=data/pi-runs
PI_MODEL=deepseek-v4-flash
PI_THINKING=high
# 0 = sin timeout
PI_TIMEOUT_SECONDS=1800
PI_MAX_CONCURRENT=2
PI_MAX_PROMPT_CHARS=100000

# pi-chrome se instala con pnpm y esta es su extension de Pi. Ademas hay que
# cargar manualmente la extension companion unpacked en Chrome una sola vez:
#   ./scripts/setup-pi-chrome.sh --open
PI_CHROME_EXTENSION=./node_modules/pi-chrome/extensions/chrome-profile-bridge/index.ts
# Mantener en 0 salvo que los usuarios autorizados puedan controlar con
# seguridad el perfil Chrome iniciado en la maquina del backend.
PI_CHROME_AUTO_AUTHORIZE=0
PI_CHROME_AUTHORIZE_MINUTES=30
